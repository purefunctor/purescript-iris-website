{
  "name": "iris-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#output/*": "./output/*"
  },
  "scripts": {
    "build:purescript": "iris build",
    "prepare:dev": "pnpm build:purescript",
    "build": "pnpm build:purescript && astro build",
    "dev": "pnpm prepare:dev && concurrently --kill-others --names compiler,astro --prefix-colors cyan,magenta \"iris watch --output output\" \"astro dev\"",
    "preview": "wrangler dev",
    "sources": "spago sources"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/bruno-ace": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "astro": "7.2.9",
    "inter-ui": "4.1.1",
    "react": "18.3.1",
    "react-aria-components": "1.20.0",
    "react-dom": "18.3.1",
    "satori": "^0.33.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.126",
    "@iconify-json/simple-icons": "1.2.93",
    "@stylexjs/unplugin": "0.19.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "concurrently": "10.0.5",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.2",
    "wrangler": "4.136.1"
  },
  "packageManager": "pnpm@12.3.4"
}
