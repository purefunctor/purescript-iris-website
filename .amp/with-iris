#!/usr/bin/env bash
set -euo pipefail

compiler_repository=${IRIS_REPOSITORY:-../repos/purescript-iris}
compiler_manifest="$compiler_repository/Cargo.toml"

if [[ ! -f "$compiler_manifest" ]]; then
  printf 'Iris compiler repository not found at %s\n' "$compiler_repository" >&2
  printf 'Set IRIS_REPOSITORY to its checkout path.\n' >&2
  exit 1
fi

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
cargo build \
  --release \
  --locked \
  --manifest-path "$compiler_manifest" \
  --package purescript-iris \
  --bin iris

export PATH="$compiler_repository/target/release:$PATH"
exec -- "$@"
