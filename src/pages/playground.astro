---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/anybody";
import "@fontsource-variable/oxanium";
import "inter-ui/inter-variable.css";
import "#src/global.css";
import * as Playground from "#output/Website.Playground.Index/index.js";

Astro.response.headers.set("X-Content-Type-Options", "nosniff");
Astro.response.headers.set("Cache-Control", "no-cache");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
Astro.response.headers.set("Content-Security-Policy", "frame-ancestors 'none'");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style is:inline>@layer reset, priority1, priority2, priority3, priority4;</style>
    <style>html { scrollbar-gutter: auto; }</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Try IRIS in your browser. Edit IRIS and inspect the generated JavaScript, with packages from the PureScript ecosystem ready to import." />
    <title>Playground — IRIS</title>
    {import.meta.env.DEV && <>
      <link rel="stylesheet" href="/virtual:stylex.css" />
      <script type="module" src="/@id/virtual:stylex:runtime"></script>
    </>}
  </head>
  <body>
    <Playground.component client:load />
    <noscript>The playground needs JavaScript and WebAssembly to compile in your browser. Your source is not sent to a server.</noscript>
  </body>
</html>
