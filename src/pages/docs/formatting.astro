---
import SiteLayout from "#src/layouts/SiteLayout.astro";
import * as Formatting from "#output/Website.Documentation.Formatting/index.js";

export const prerender = true;
---

<SiteLayout
  title="Formatting — Iris documentation"
  description="Format PureScript sources with iris format, check formatting in CI, and format documents from your editor."
>
  <Fragment slot="head">
    {
      import.meta.env.DEV ? (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      ) : (
        <link rel="stylesheet" href="/assets/stylex.css" />
      )
    }
  </Fragment>
  <Formatting.component client:load />
</SiteLayout>
