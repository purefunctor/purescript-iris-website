---
import SiteLayout from "#src/layouts/SiteLayout.astro";
import * as LanguageServer from "#output/Website.Documentation.LanguageServer/index.js";

export const prerender = true;
---

<SiteLayout
  title="Language server — Iris documentation"
  description="Set up the Iris language server in Visual Studio Code or another editor, configure diagnostics, and learn how Iris prepares your Spago workspace."
>
  <Fragment slot="head">
    {
      import.meta.env.DEV ? (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      ) : (
        <link rel="stylesheet" href="/assets/stylex.css" />
      )
    }
  </Fragment>
  <LanguageServer.component client:load />
</SiteLayout>
