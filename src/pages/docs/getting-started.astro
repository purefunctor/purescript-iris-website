---
import SiteLayout from "#src/layouts/SiteLayout.astro";
import * as GettingStarted from "#output/Website.Documentation.GettingStarted/index.js";

export const prerender = true;
---

<SiteLayout
  title="Getting started — Iris documentation"
  description="Install Iris, create your first PureScript workspace, compile it, and run a command-line application with Node.js."
>
  <Fragment slot="head">
    {
      import.meta.env.DEV ? (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      ) : (
        <link rel="stylesheet" href="/assets/stylex.css" />
      )
    }
  </Fragment>
  <GettingStarted.component client:load />
</SiteLayout>
