---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/oxanium";
import "inter-ui/inter-variable.css";
import "#src/global.css";
import * as Index from "#output/Website.Landing.Index/index.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style is:inline>@layer reset, priority1, priority2, priority3, priority4;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Iris is a modern, feature-rich, high-performance compiler for PureScript."
    />
    <meta name="theme-color" content="oklch(95.85% 0.0098 87.5)" />
    <title>Iris — A modern PureScript experience</title>
    {
      import.meta.env.DEV && (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      )
    }
  </head>
  <body>
    <Index.component client:load />
  </body>
</html>
