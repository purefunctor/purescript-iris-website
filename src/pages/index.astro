---
import "#src/global.css";
import { getImage } from "astro:assets";
import * as Index from "#output/Website.Landing.Index/index.js";
import brunoAceFont from "@fontsource/bruno-ace/files/bruno-ace-latin-400-normal.woff2?url";
import interFont from "inter-ui/variable-latin/InterVariable-subset.woff2?url";
import juraFont from "@fontsource-variable/jura/files/jura-latin-wght-normal.woff2?url";
import heroImage from "#src/assets/iris-digital-field.webp";

export const prerender = true;

const [desktopHeroImage, mobileHeroImage] = import.meta.env.DEV
  ? [heroImage, heroImage]
  : await Promise.all([
      getImage({ src: heroImage, width: 1672, format: "avif", quality: 45 }),
      getImage({ src: heroImage, width: 1200, format: "avif", quality: 50 }),
    ]);
const heroImageType = import.meta.env.DEV ? "image/webp" : "image/avif";
---

<!doctype html>
<html
  lang="en"
  style={`--landing-hero-image: url("${desktopHeroImage.src}"); --landing-hero-image-mobile: url("${mobileHeroImage.src}");`}
>
  <head>
    <meta charset="UTF-8" />
    <style is:inline>@layer reset, priority1, priority2, priority3, priority4;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Functional programming for the browser, the server, and everywhere in between."
    />
    <meta name="theme-color" content="oklch(98.6% 0.008 280)" />
    <title>IRIS — Functional programming for browser and server</title>
    <link rel="preload" href={desktopHeroImage.src} as="image" type={heroImageType} media="(min-width: 701px)" fetchpriority="high" />
    <link rel="preload" href={mobileHeroImage.src} as="image" type={heroImageType} media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" href={brunoAceFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={juraFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    {
      import.meta.env.DEV ? (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      ) : (
        <link rel="stylesheet" href="/assets/stylex.css" />
      )
    }
  </head>
  <body>
    <Index.component client:load />
  </body>
</html>
