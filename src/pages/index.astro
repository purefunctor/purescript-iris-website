---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/jura";
import "@fontsource/bruno-ace";
import "inter-ui/inter-variable.css";
import "#src/global.css";
import * as Index from "#output/Website.Landing.Index/index.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style is:inline>@layer reset, priority1, priority2, priority3, priority4;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Functional programming for the browser, the server, and everywhere in between."
    />
    <meta name="theme-color" content="oklch(98.6% 0.008 280)" />
    <title>IRIS — Functional programming for browser and server</title>
    {
      import.meta.env.DEV && (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      )
    }
  </head>
  <body>
    <Index.component client:load />
  </body>
</html>
