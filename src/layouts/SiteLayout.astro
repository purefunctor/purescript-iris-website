---
import "#src/global.css";
import * as Layout from "#output/Website.SiteLayout/index.js";
import { layerOrder, pressableStyle, pressableStyleId } from "#src/lib/inlineStyles.ts";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  application?: boolean;
}

const { title, description, image = "/og.png", imageAlt = "The IRIS logo and wordmark over a field of spectrum-colored dots", application = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const imageUrl = new URL(image, Astro.site!);
---

<!doctype html>
<html lang="en" {...(application ? Layout.application : Layout.html)}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={layerOrder} />
    <style is:inline id={pressableStyleId} set:html={pressableStyle} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(16% 0.004 255)" />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IRIS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
