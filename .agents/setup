#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0
step() {
  local label=$1 start=$SECONDS
  shift
  printf '\n%s…\n' "$label"
  "$@"
  printf '%s: %ss (%ss total)\n' "$label" "$((SECONDS - start))" "$SECONDS"
}

printf 'Installing Node.js and pnpm…\n'
export PATH="$HOME/.local/share/fnm:$PATH"

if ! command -v fnm >/dev/null 2>&1; then
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi

eval "$(fnm env --shell bash)"
node_version=$(<.node-version)
if ! fnm use "$node_version"; then
  fnm install "$node_version"
  fnm use "$node_version"
fi
fnm default "$node_version"

export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$PNPM_HOME/bin:$PATH"
if [[ ! -x "$PNPM_HOME/bin/pnpm" ]]; then
  package_manager=$(node -p 'require("./package.json").packageManager')
  curl -fsSL https://get.pnpm.io/install.sh \
    | env PNPM_VERSION="${package_manager#pnpm@}" SHELL=/bin/bash sh -
fi

# Service processes use login shells, not the environment of this setup process.
if ! grep -Fqx 'export PATH="$HOME/.local/share/fnm:$PATH"' "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Iris tool managers
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --shell bash)"
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$PNPM_HOME/bin:$PATH"
EOF
fi
hash -r
printf 'Node.js and pnpm ready (%ss total).\n' "$SECONDS"

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export RUSTUP_TOOLCHAIN=stable
printf 'Preparing release compiler toolchains (%ss elapsed)…\n' "$SECONDS"

if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
fi

if ! rustup run stable rustc --version >/dev/null 2>&1; then
  step 'Installing Rust stable' rustup toolchain install stable --profile minimal
fi
rustup default stable
if ! rustup target list --installed | grep -qx wasm32-unknown-unknown; then
  step 'Installing WASM target' rustup target add wasm32-unknown-unknown
fi

if [[ $(wasm-bindgen --version 2>/dev/null || true) != "wasm-bindgen 0.2.127" ]]; then
  if ! command -v cargo-binstall >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
      | bash
  fi
  step 'Installing wasm-bindgen' cargo binstall wasm-bindgen-cli --version 0.2.127 --locked --no-confirm
fi

# Snapshot the expensive inputs to development, not a production Astro build.
# Cargo and Iris reuse their caches when setup runs on a stale snapshot.
step 'Installing project dependencies' pnpm install --frozen-lockfile
step 'Preparing native compiler, WASM and PureScript' pnpm prepare:dev
printf 'Development inputs ready in %ss. Resume starts the website portal.\n' "$SECONDS"
