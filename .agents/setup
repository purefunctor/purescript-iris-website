#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0
step() {
  local label=$1 start=$SECONDS
  shift
  printf '\n%s…\n' "$label"
  "$@"
  printf '%s: %ss (%ss total)\n' "$label" "$((SECONDS - start))" "$SECONDS"
}

printf 'Installing Node.js and pnpm…\n'
export PATH="$HOME/.local/share/fnm:$HOME/.local/bin:$PATH"

if ! command -v fnm >/dev/null 2>&1; then
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi

eval "$(fnm env --shell bash)"
node_version=$(<.node-version)
if ! fnm use "$node_version"; then
  fnm install "$node_version"
  fnm use "$node_version"
fi
fnm default "$node_version"

export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$PNPM_HOME/bin:$PATH"
if [[ ! -x "$PNPM_HOME/bin/pnpm" ]]; then
  package_manager=$(node -p 'require("./package.json").packageManager')
  curl -fsSL https://get.pnpm.io/install.sh \
    | env PNPM_VERSION="${package_manager#pnpm@}" SHELL=/bin/bash sh -
fi

# Service processes use login shells, not the environment of this setup process.
if ! grep -Fqx 'export PATH="$HOME/.local/bin:$PATH"' "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Iris tool managers
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --shell bash)"
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$PNPM_HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
EOF
fi
hash -r
printf 'Node.js and pnpm ready (%ss total).\n' "$SECONDS"

install_iris() {
  curl --proto '=https' --tlsv1.2 -fsSL --retry 3 \
    https://raw.githubusercontent.com/purefunctor/purescript-iris/v0.1.4/install.sh \
    | env IRIS_VERSION=v0.1.4 IRIS_SKIP_ATTESTATION=1 sh
}

step 'Installing Iris 0.1.4' install_iris
# Snapshot the development inputs, not a production Astro build.
step 'Installing project dependencies' pnpm install --frozen-lockfile
step 'Preparing PureScript' pnpm prepare:dev
printf 'Development inputs ready in %ss. Resume starts the website portal.\n' "$SECONDS"
